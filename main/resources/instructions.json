{
  "categories": [
    { "id": "files", "name": "Команды для работы с файлами" },
    { "id": "report", "name": "Команды для работы с отчётом" }
  ],

  "commands": {
    "cd": { "name": "cd", "category": "files",
      "description": "Сменить текущий каталог",
      "usage": "cd [ПУТЬ]/home/up",
      "examples": [
        { "cmd": "cd testfile", "desc": "Переместиться в каталог testfile" },
        { "cmd": "cd up", "desc": "Подняться на уровень вверх" },
        { "cmd": "cd home", "desc": "Вернуться в корневой каталог сессии" } ],
      "reportBehavior": "Перейдём в каталог `{relativeDirectory}`." },

    "pwd": { "name": "pwd", "category": "files",
      "description": "Показать текущий каталог",
      "usage": "pwd",
      "examples": [{ "cmd": "pwd", "desc": "Текущий путь" }],
      "reportBehavior": "Текущий рабочий каталог: `{relativeDirectory}`." },

    "ls":  { "name": "ls", "category": "files",
      "description": "Вывод содержимого каталога",
      "usage": "ls [ПУТЬ]",
      "examples": [
        { "cmd": "ls", "desc": "Содержимое текущего каталога" },
        { "cmd": "ls testfile", "desc": "Содержимое каталога testfile" } ],
      "reportBehavior": "Просмотрим содержимое каталога `{relativeDirectory}`." },

    "mkdir": { "name": "mkdir", "category": "files",
      "description": "Создать каталог",
      "usage": "mkdir [НАЗВАНИЕ КАТАЛОГА]",
      "examples": [{ "cmd": "mkdir testfile", "desc": "Создание каталога с названием testfile" }],
      "reportBehavior": "Создадим каталог `{argument1}`." },

    "touch": { "name": "touch", "category": "files",
      "description": "Создать файл",
      "usage": "touch [НАЗВАНИЕ ФАЙЛА.РАСШИРЕНИЕ]",
      "examples": [{ "cmd": "touch kitset.txt", "desc": "Создание файла kitset.txt" }],
      "reportBehavior": "Создадим файл `{argument1}`." },

    "cat":  { "name": "cat", "category": "files",
      "description": "Показать содержимое файла",
      "usage": "cat [НАЗВАНИЕ ФАЙЛА.РАСШИРЕНИЕ]",
      "examples": [{ "cmd": "cat kitset.txt", "desc": "Показать содержимое файла kitset.txt" }],
      "reportBehavior": "Просмотрим содержимое файла `{argument1}`." },

    "cp": { "name": "cp", "category": "files",
      "description": "Копировать файл или каталог",
      "usage": "cp [ИСТОЧНИК] [НАЗНАЧЕНИЕ]",
      "examples": [{ "cmd": "cp kitset.txt testik.txt", "desc": "Копируем данные из kitset.txt в testik.txt" }],
      "reportBehavior": "Скопируем `{argument1}` в `{argument2}`." },

    "mv": { "name": "mv", "category": "files",
      "description": "Переименовать или переместить файл",
      "usage": "mv rename [СТАРОЕ ИМЯ ФАЙЛА] [НОВОЕ ИМЯ ФАЙЛА]  ИЛИ  mv move [ФАЙЛ] [КАТАЛОГ]",
      "examples": [
        { "cmd": "mv rename kitset.txt testik.txt", "desc": "Переименовываем файл с kitset.txt на testik.txt" },
        { "cmd": "mv move testik.txt testfile",     "desc": "Перемещаем testik.txt в каталог testfile" } ],
      "reportBehavior": "Переместим `{argument1}` в `{argument2}`." },

    "rm": { "name": "rm", "category": "files",
      "description": "Удалить файл или каталог",
      "usage": "rm [НАЗВАНИЕ ФАЙЛА ИЛИ КАТАЛОГА]",
      "examples": [{ "cmd": "rm testik.txt", "desc": "Удаляем файл testik.txt" }],
      "reportBehavior": "**Внимание:** удаление `{argument1}`." },

    "exit": { "name": "exit", "category": "report",
      "description": "Выйти из программы",
      "usage": "exit",
      "examples": [{ "cmd": "exit", "desc": "Выход из программы" }],
      "reportBehavior": "Не попадает в отчёт." },

    "starts": { "name": "starts", "category": "report",
      "description": "Начать сессию с записью протокола",
      "usage": "starts [НАЗВАНИЕ СЕССИИ]",
      "examples": [{ "cmd": "starts Pipup", "desc": "Начинаем сессию Pipup" }],
      "reportBehavior": "Создаёт новую сессию." },

    "prootd": { "name": "prootd", "category": "report",
      "description": "Установить корневой каталог сессии",
      "usage": "prootd [ПУТЬ]",
      "examples": [
        { "cmd": "prootd .", "desc": "Текущий каталог устанавливается, как корневой каталог сессии" },
        { "cmd": "prootd testfile",   "desc": "Каталог testfile устанавливается, как корневой каталог сессии" } ],
      "reportBehavior": "Определяет относительные пути в отчёте." },

    "mstep":   { "name": "mstep", "category": "report",
      "description": "Начать новый шаг",
      "usage": "mstep [НАЗВАНИЕ ШАГА]",
      "examples": [{ "cmd": "mstep Проверка", "desc": "Создаем новый шаг <Проверка>" }],
      "reportBehavior": "Разделяет отчёт на разделы." },

    "mnote":   { "name": "mnote", "category": "report",
      "description": "Добавить комментарий",
      "usage": "mnote [ТЕКСТ]",
      "examples": [{ "cmd": "mnote Миш, давай все по-новой, ...", "desc": "Добавить комментарий <Миш, давай все по-новой, ...>" }],
      "reportBehavior": "Добавляет абзац в шаг." },

    "mskip":   { "name": "mskip", "category": "report",
      "description": "Исключить следующую команду из отчёта",
      "usage": "mskip",
      "examples": [{ "cmd": "mskip", "desc": "Не записывать следующую команду в отчет" }],
      "reportBehavior": "Команда выполняется, но не попадает в отчёт." },

    "mstatus": { "name": "mstatus", "category": "report",
      "description": "Показать состояние сессии",
      "usage": "mstatus",
      "examples": [{ "cmd": "mstatus", "desc": "Показать состояние сессии" }],
      "reportBehavior": "Выводит информацию в консоль." },

    "mpreview":{ "name": "mpreview", "category": "report",
      "description": "Предварительный отчёт",
      "usage": "mpreview",
      "examples": [{ "cmd": "mpreview", "desc": "Создать черновик отчёта" }],
      "reportBehavior": "Создаёт временный файл." },

    "info":    { "name": "info", "category": "report",
      "description": "Информация о лабораторной работе и авторе",
      "usage": "info",
      "examples": [{ "cmd": "info", "desc": "Показать справку с информацией об лабораторной работе и авторе" }],
      "reportBehavior": "Не попадает в отчёт." },

    "instructions": { "name": "instructions", "category": "report",
      "description": "Справка по командам",
      "usage": "instructions [НОМЕР/ИМЯ КОМАНДЫ]",
      "examples": [
        { "cmd": "instructions",     "desc": "Список всех команд" },
        { "cmd": "instructions 3",   "desc": "Справка по команде #3 (ls)" },
        { "cmd": "instructions ls",  "desc": "Справка по ls" } ],
      "reportBehavior": "Не попадает в отчёт." },

    "ends":    { "name": "ends", "category": "report",
      "description": "Завершить сессию и создать отчёт",
      "usage": "ends",
      "examples": [{ "cmd": "ends", "desc": "Завершить сессию" }],
      "reportBehavior": "Генерирует Markdown-отчёт." }
  }
}