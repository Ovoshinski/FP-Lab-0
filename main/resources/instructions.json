{
  "categories": [
    { "id": "service", "name": "Служебные команды" },
    { "id": "filesystem", "name": "Файловая система" }
  ],
  "commands": {
    "ends":    { "name": "ends", "category": "service",
      "description": "Завершить сессию и создать отчёт",
      "usage": "ends",
      "examples": [{ "cmd": "ends", "desc": "завершить" }],
      "reportBehavior": "Генерирует Markdown-отчёт." },
    "starts":  { "name": "starts", "category": "service",
      "description": "Начать протоколируемую сессию",
      "usage": "starts \"Название\"",
      "examples": [{ "cmd": "starts \"Лаба 1\"", "desc": "начать" }],
      "reportBehavior": "Создаёт новую сессию." },
    "prootd":  { "name": "prootd", "category": "service",
      "description": "Установить корневой каталог",
      "usage": "prootd ПУТЬ",
      "examples": [{ "cmd": "prootd .", "desc": "текущий каталог" }],
      "reportBehavior": "Определяет относительные пути." },
    "mstep":   { "name": "mstep", "category": "service",
      "description": "Начать новый шаг",
      "usage": "mstep \"Название\"",
      "examples": [{ "cmd": "mstep \"Компиляция\"", "desc": "новый шаг" }],
      "reportBehavior": "Разделяет отчёт на разделы." },
    "mnote":   { "name": "mnote", "category": "service",
      "description": "Добавить комментарий",
      "usage": "mnote \"Текст\"",
      "examples": [{ "cmd": "mnote \"Используем O2\"", "desc": "комментарий" }],
      "reportBehavior": "Добавляет абзац в шаг." },
    "mskip":   { "name": "mskip", "category": "service",
      "description": "Исключить следующую команду из отчёта",
      "usage": "mskip",
      "examples": [{ "cmd": "mskip", "desc": "пропустить" }],
      "reportBehavior": "Команда выполняется, но не попадает в отчёт." },
    "mstatus": { "name": "mstatus", "category": "service",
      "description": "Показать состояние сессии",
      "usage": "mstatus",
      "examples": [{ "cmd": "mstatus", "desc": "статус" }],
      "reportBehavior": "Выводит информацию в консоль." },
    "mpreview":{ "name": "mpreview", "category": "service",
      "description": "Предварительный отчёт",
      "usage": "mpreview",
      "examples": [{ "cmd": "mpreview", "desc": "черновик" }],
      "reportBehavior": "Создаёт временный файл." },
    "cd":      { "name": "cd", "category": "filesystem",
      "description": "Сменить текущий каталог",
      "usage": "cd ПУТЬ",
      "examples": [
        { "cmd": "cd src", "desc": "в подпапку" },
        { "cmd": "cd ..", "desc": "вверх" },
        { "cmd": "cd ~", "desc": "домой" } ],
      "reportBehavior": "Описывается как «Перейдём в каталог»." },
    "pwd":     { "name": "pwd", "category": "filesystem",
      "description": "Показать текущий каталог",
      "usage": "pwd",
      "examples": [{ "cmd": "pwd", "desc": "текущий путь" }],
      "reportBehavior": "Показывает каталог." },
    "ls":      { "name": "ls", "category": "filesystem",
      "description": "Вывод содержимого каталога",
      "usage": "ls [ОПЦИИ] [ПУТЬ]",
      "options": [
        { "flag": "-l", "description": "подробный формат" },
        { "flag": "-a", "description": "показать скрытые файлы" } ],
      "examples": [
        { "cmd": "ls", "desc": "текущий каталог" },
        { "cmd": "ls -la", "desc": "подробно, со скрытыми" } ],
      "reportBehavior": "Описывается как «Просмотрим содержимое каталога»." },
    "mkdir":   { "name": "mkdir", "category": "filesystem",
      "description": "Создать каталог",
      "usage": "mkdir [ОПЦИИ] КАТАЛОГ...",
      "options": [{ "flag": "-p", "description": "создать промежуточные" }],
      "examples": [{ "cmd": "mkdir src", "desc": "один каталог" }],
      "reportBehavior": "Описывается как «Создадим каталог»." },
    "touch":   { "name": "touch", "category": "filesystem",
      "description": "Создать файл",
      "usage": "touch ФАЙЛ...",
      "examples": [{ "cmd": "touch Main.hs", "desc": "создать файл" }],
      "reportBehavior": "Описывается как «Создадим файл»." },
    "cat":     { "name": "cat", "category": "filesystem",
      "description": "Показать содержимое файла",
      "usage": "cat [ОПЦИИ] ФАЙЛ...",
      "examples": [{ "cmd": "cat config.txt", "desc": "показать файл" }],
      "reportBehavior": "Описывается как «Просмотрим содержимое файла»." },
    "cp":      { "name": "cp", "category": "filesystem",
      "description": "Копировать файл или каталог",
      "usage": "cp [ОПЦИИ] ИСТОЧНИК НАЗНАЧЕНИЕ",
      "examples": [{ "cmd": "cp a.txt b.txt", "desc": "копировать" }],
      "reportBehavior": "Описывается как «Скопируем»." },
    "mv":      { "name": "mv", "category": "filesystem",
      "description": "Переместить или переименовать",
      "usage": "mv ИСТОЧНИК НАЗНАЧЕНИЕ",
      "examples": [{ "cmd": "mv old.txt new.txt", "desc": "переименовать" }],
      "reportBehavior": "Описывается как «Переместим»." },
    "rm":      { "name": "rm", "category": "filesystem",
      "description": "Удалить файл или каталог",
      "usage": "rm [ОПЦИИ] ФАЙЛ...",
      "options": [
        { "flag": "-r", "description": "рекурсивно" },
        { "flag": "-f", "description": "принудительно" } ],
      "examples": [{ "cmd": "rm old.txt", "desc": "удалить файл" }],
      "reportBehavior": "Выделяется как потенциально опасная операция." },
    "info":    { "name": "info", "category": "service",
      "description": "Информация о программе и авторе",
      "usage": "info",
      "examples": [{ "cmd": "info", "desc": "справка" }],
      "reportBehavior": "Не попадает в отчёт." },
    "instructions": { "name": "instructions", "category": "service",
      "description": "Справка по командам",
      "usage": "instructions [НОМЕР_ИЛИ_ИМЯ]",
      "examples": [
        { "cmd": "18", "desc": "список всех команд" },
        { "cmd": "18 10", "desc": "справка по команде #10 (ls)" },
        { "cmd": "18 ls", "desc": "справка по ls" } ],
      "reportBehavior": "Не попадает в отчёт." },
    "exit":    { "name": "exit", "category": "service",
      "description": "Выйти из программы",
      "usage": "exit",
      "examples": [{ "cmd": "exit", "desc": "выход" }],
      "reportBehavior": "Не попадает в отчёт." }
  }
}